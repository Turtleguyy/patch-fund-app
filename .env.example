# Copy to .env and fill in values. Never commit .env to git.

# OpenAI API key for natural-language allowance parsing.
# Get one at https://platform.openai.com/api-keys
EXPO_PUBLIC_OPENAI_API_KEY=sk-your-key-here

# Apple Developer Team ID (10 characters), required for iOS builds with App Groups.
# Find it at https://developer.apple.com/account → Membership details.
APPLE_TEAM_ID=XXXXXXXXXX

# Supabase (household sync). Project Settings → API in the Supabase dashboard.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Sign-In (native). Create OAuth clients in Google Cloud Console.
# Web client ID → also paste into Supabase → Authentication → Providers → Google.
EXPO_PUBLIC_GOOGLE_AUTH_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# iOS client ID for bundle com.zach.patchfund (required for native Google on iPhone).
EXPO_PUBLIC_GOOGLE_AUTH_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
